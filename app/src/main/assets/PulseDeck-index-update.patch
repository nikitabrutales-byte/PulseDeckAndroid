+ const g=+$(`gain${d.id}`).value;
+ const fader=clamp(Number($(`vol${d.id}`).value),0,100);
+ const vol=fader===0?0:smoothVolumeCurve(fader);
+ const normalization=d.normRaw||1;
+ // Exact-zero hard mute at the final per-deck gain stage.
+ const targetGain=fader===0?0:Math.pow(10,g/20)*vol*normalization;
+ const gainParam=d.nodes.gain.gain;
+ gainParam.cancelScheduledValues(ctx.currentTime);
+ gainParam.setValueAtTime(targetGain,ctx.currentTime);
+ if(fader!==0)gainParam.setTargetAtTime(targetGain,ctx.currentTime,.025);
